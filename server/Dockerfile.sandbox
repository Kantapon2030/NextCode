# syntax=docker/dockerfile:1.4
FROM ubuntu:22.04 AS runtime

# Disable interactive frontend during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential compilers, runtimes, and dumb-init
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3 \
    python3-minimal \
    libc6-dev \
    libstdc++-11-dev \
    dumb-init \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Remove high-risk administrative binaries
RUN rm -f /usr/bin/wget /usr/bin/curl /usr/bin/nc /usr/bin/ncat \
    /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg /usr/bin/chroot /usr/bin/su

# Create non-root sandbox user (UID 10001)
RUN groupadd -g 10001 sandbox && \
    useradd -u 10001 -g sandbox -s /usr/sbin/nologin -M -d /nonexistent sandbox

# Create workspace directory with restricted permissions
RUN mkdir -p /workspace && \
    chown -R sandbox:sandbox /workspace && \
    chmod 700 /workspace

WORKDIR /workspace
USER 10001:10001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["sleep", "infinity"]
